      ],
      "paraphrase": true
    },
    {
      "id": "habitat-paraphrase",
      "text": "construction works displacing nesting groups",
      "topic": "habitat-disturbance",
      "relevant_keys": [
        "week-02-construction-pressure"
      ],
      "paraphrase": true
    }
  ]
}
